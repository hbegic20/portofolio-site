# Copy to .env.local and fill in. Never commit real values.

# Postgres (Neon or Supabase) — used by drizzle for the contact form
DATABASE_URL=

# Upstash Redis — rate limiting for /api/v1/contact
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — contact form notifications
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional until you verify a domain in Resend; defaults to onboarding@resend.dev
CONTACT_FROM_EMAIL=

# GitHub GraphQL — contribution grid + pinned repos (read-only token)
GITHUB_TOKEN=

# Public site URL, used for canonical URLs, OG and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000
